# Copy to .env and edit. All values have working defaults for local dev.

# SQLite by default; switch to Postgres later with e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/smartring
DATABASE_URL=sqlite:///./smartring.db

# Signs session JWTs. This placeholder is a repo-known value, so the server
# treats it as "unset": in dev mode it generates a private key at
# server/.jwt_secret (gitignored); with AUTH_DEV_MODE=false it refuses to start
# until you put a real one here. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# OAuth client ID from Google Cloud Console (iOS client). NOT a secret — it is
# baked into every app bundle, and already appears in ios/Support/Info.plist.
# Dev auth works without it. To actually sign in with Google you must also be
# added as a test user on the consent screen (Testing mode) — ask the repo
# owner, otherwise Google returns 403.
GOOGLE_CLIENT_ID=859022544598-49onfvbg39tqhsv34imlnju2a4qqfhnc.apps.googleusercontent.com

# OAuth "Web application" client ID for the Android app (android/TcmSessionApp)
# — Android's Credential Manager Sign-In issues ID tokens whose audience is
# this Web client, not an "Android"-type client, so this is a DIFFERENT ID
# from GOOGLE_CLIENT_ID above even though both live in the same Cloud
# project. Also NOT a secret — it's baked into LoginActivity.kt's
# GOOGLE_WEB_CLIENT_ID the same way GOOGLE_CLIENT_ID is baked into the iOS
# bundle. Shipped here (not blank) so a new collaborator's .env works on
# copy; leaving it blank disables Google Sign-In on Android only (iOS is
# unaffected). A matching "Android"-type OAuth client (package name +
# debug-keystore SHA-1) must also exist in the same Cloud project for Google
# Play Services to trust the signed APK, even though its ID never appears in
# code.
GOOGLE_CLIENT_ID_ANDROID=859022544598-o06r56lk8k8njojk19gqpq5kq36nie1t.apps.googleusercontent.com

# Allows POST /auth/dev (email+role login with no Google). Never enable in production.
AUTH_DEV_MODE=true

# Session lifetime in minutes. Default is 30 days (60 * 24 * 30 = 43200).
# JWT_EXPIRE_MINUTES=43200

# Name of the single clinic every practitioner is auto-assigned to.
# SEED_CLINIC_NAME=Example Clinic

# SMTP credentials for sending account-verification emails (POST /auth/register).
# Leave blank in local dev if you don't need real email — register() will
# 503 with "Email sending is not configured" rather than silently no-op.
# For Gmail: use an App Password (not your normal password) — enable 2FA,
# then generate one at https://myaccount.google.com/apppasswords.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Practitioner signup codes go to this team inbox instead of the address the
# practitioner typed: a deliberate gate for the prototype, since practitioners
# see every patient's data. Set it blank to send codes to the typed address.
# PRACTITIONER_VERIFICATION_INBOX=smartringapptest@gmail.com

# Claude API key for the "Summarize" buttons (patient overview and single
# session; on-demand only — never called automatically). Leave blank in local
# dev if you don't need it — the endpoint 503s with "AI summaries are not
# configured" rather than silently no-op. Create a key in the Claude Console
# under API keys. A secret: never commit it, only put it in .env.
ANTHROPIC_API_KEY=

# AssemblyAI API key for voice markers (spoken notes transcribed during a
# session, POST /sessions/transcribe). Leave blank if you don't need voice
# markers — that endpoint 503s rather than silently no-op. A secret: never
# commit it, only put it in .env.
ASSEMBLYAI_API_KEY=

# Mains hum frequency notched out during raw-EEG analysis (see
# app/eeg/analysis.py, POST /sessions/{id}/eeg/analyze). 60 for the US pilot
# clinic (the default if unset); set to 50 for a clinic on European mains.
# EEG_MAINS_HZ=60

# Cloud Storage bucket for raw EEG recordings (app/eeg/storage.py). Leave
# blank to keep them in server/data/eeg_raw/ on local disk (the dev Mac).
# Required on Cloud Run — see docs/cloud-deploy.md.
# EEG_RAW_BUCKET=
