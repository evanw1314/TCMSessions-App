<?xml version="1.0" encoding="utf-8"?>
<!-- Dropdown-list-only row for bandSelectSpinner (SessionDetailActivity) — the
     closed/collapsed spinner keeps the compact system default; this is just for
     the open list, with extra vertical padding so each option is easier to tap. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/text1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:textSize="15sp" />
