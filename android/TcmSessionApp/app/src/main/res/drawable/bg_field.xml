<?xml version="1.0" encoding="utf-8"?>
<!-- Shared outline shape for the wireframe's .searchbox/.row/.ghostbtn look:
     surface_1 fill, 1dp border, small radius. Used for EditText backgrounds. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface_1" />
    <stroke android:width="1dp" android:color="@color/border" />
    <corners android:radius="@dimen/radius_sm" />
</shape>
